# Copy this file to ".env" and fill in your Gemini API key(s).
# You can add multiple accounts/keys; they will be rotated automatically
# whenever one hits a quota/rate-limit error. Numbering controls priority
# order (GEMINI_API_KEY_1 is tried before GEMINI_API_KEY_2, etc.).

GEMINI_API_KEY_1=your_gemini_api_key_here
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
